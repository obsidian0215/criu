+static int page_server_check_parent_range(int sk, struct page_server_iov *pi)
+{
+	struct iovec iov;
+	unsigned long id;
+	int covered, type;
+
+	type = decode_pm(pi->dst_id, &id);
+	if (type == -1) {
+		pr_err("Unknown pagemap type received\n");
+		return -1;
+	}
+	if (!pi->nr_pages || (pi->vaddr & (PAGE_SIZE - 1)) ||
+	    pi->vaddr > ULONG_MAX || pi->nr_pages > SIZE_MAX / PAGE_SIZE ||
+	    pi->nr_pages > (ULONG_MAX - (unsigned long)pi->vaddr) / PAGE_SIZE) {
+		pr_err("Invalid parent range %#" PRIx64 "+%" PRIu64 " pages\n",
+		       pi->vaddr, pi->nr_pages);
+		return -1;
+	}
+
+	psi2iovec(pi, &iov);
+	covered = check_parent_local_range(type, id, &iov);
+	if (send_full(sk, &covered, sizeof(covered), "page-server parent range response"))
+		return -1;
+	return 0;
+}
+
+static int check_parent_server_range(u64 dst_id, struct iovec *iov)
+{
+	struct page_server_iov pi = {
+		.cmd = PS_IOV_PARENT_RANGE,
+		.nr_pages = iov->iov_len / PAGE_SIZE,
+		.vaddr = encode_pointer(iov->iov_base),
+		.dst_id = dst_id,
+	};
+	int covered;
+
+	if (send_psi(page_server_sk, &pi))
+		return -1;
+	tcp_nodelay(page_server_sk, true);
+	if (recv_full(page_server_sk, &covered, sizeof(covered),
+		      "page-server parent range response"))
+		return -1;
+	if (covered < 0)
+		return -1;
+	return covered ? 0 : -1;
+}
