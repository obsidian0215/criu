+static int check_parent_local_range(int fd_type, unsigned long img_id, struct iovec *iov)
+{
+	struct page_read pr;
+	int pfd, pr_flags, ret;
+
+	if (open_parent(get_service_fd(IMG_FD_OFF), &pfd))
+		return -1;
+	if (pfd < 0)
+		return 0;
+
+	pr_flags = fd_type == CR_FD_PAGEMAP ? PR_TASK : PR_SHMEM;
+	ret = open_page_read_at(pfd, img_id, &pr, pr_flags);
+	close(pfd);
+	if (ret <= 0)
+		return ret;
+
+	page_read_disable_dedup(&pr);
+	ret = check_pagehole_in_parent(&pr, iov) ? 0 : 1;
+	pr.close(&pr);
+	return ret;
+}
