+	"$RUNC" --root "$SRC_ROOT" checkpoint --pre-dump --page-server "127.0.0.1:$port" \
+		--image-path "$dir/source/parent0" "$ID" >"$dir/pre-dump.log" 2>&1
+	wait "$PS_PID"
